# ==========================================
# Sunday Funday — Personal Finance ERP
# Environment Configuration Template
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=finance_erp
POSTGRES_PORT=5432

# Backend API Configuration (apps/api)
DATABASE_URL="postgresql://postgres:password@localhost:5433/finance_erp?schema=public"
PORT=3001
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Frontend Web Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://api:3001
PORT=3000

